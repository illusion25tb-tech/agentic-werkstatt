diff --git a/tests/test_cancel.py b/tests/test_cancel.py
new file mode 100644
index 0000000..8259ff1
--- /dev/null
+++ b/tests/test_cancel.py
@@ -0,0 +1,27 @@
+from conftest import paid_order, place_order
+
+
+def test_cancel_new(client):
+    order_id = place_order(client, [("ZS-2", 2)]).json()["id"]
+    r = client.post(f"/orders/{order_id}/cancel", json={})
+    assert r.status_code == 200
+    assert r.json()["status"] == "cancelled"
+
+
+def test_cancel_partial(client):
+    order = paid_order(client, [("ZS-2", 2)])
+    r = client.post(
+        f"/orders/{order['id']}/cancel",
+        json={"lines": [{"sku": "ZS-2", "quantity": 1}]},
+    )
+    assert r.status_code == 200
+    assert r.json()["status"] == "partially_cancelled"
+    refunds = client.get(f"/orders/{order['id']}/refunds")
+    assert refunds.json()[0]["amount"] == 6.95
+
+
+def test_cancel_with_label(client):
+    order = paid_order(client, [("AKS-18", 1)])
+    client.post(f"/orders/{order['id']}/label")
+    r = client.post(f"/orders/{order['id']}/cancel", json={})
+    assert r.status_code == 200
