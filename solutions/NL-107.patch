@@ -0,0 +1,23 @@
+"""Regressionstest NL-107: Sperrguttarif über 31,5 kg."""
+
+import pytest
+from conftest import paid_order
+
+from bestellservice import tariffs
+
+
+def test_limit_itself_is_standard():
+    assert tariffs.tariff_for(31.5).code == "PF-STD-XL"
+
+
+@pytest.mark.parametrize("weight", [31.51, 33.5, 38.0, 60.0])
+def test_above_limit_is_bulky(weight):
+    assert tariffs.tariff_for(weight).code == "PF-SPG"
+
+
+def test_label_for_workbench(client):
+    order = paid_order(client, [("WB-200", 1)])
+    label = client.post(f"/orders/{order['id']}/label").json()
+    assert label["weight_kg"] == 38.0
+    assert label["tariff_code"] == "PF-SPG"
+    assert "PF-SPG (Sperrgut)" in label["text"]
