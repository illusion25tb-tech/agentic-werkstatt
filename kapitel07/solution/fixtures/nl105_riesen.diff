+def _refund_amount(order: dict, lines: list) -> float:
+    """Erstattung: anteilig nach Positionen, ohne Versand."""
+    if not lines:
+        return order["total"]
+    amount = 0.0
+    prices = {i["sku"]: i["unit_price"] for i in order["items"]}
+    for sku, quantity in lines:
+        amount += prices[sku] * quantity
+    if order["discount"]:
+        share = amount / order["subtotal"]
+        amount -= order["discount"] * share
+    return round(amount, 2)
+
+
+def cancel_order(
+    conn: sqlite3.Connection,
+    order_id: int,
+    reason: str,
+    lines: list[tuple[str, int]],
+    refund: bool,
+    clock: Callable[[], datetime] = datetime.now,
+) -> dict:
+    """Storniert eine Bestellung ganz oder teilweise."""
+    order = get_order(conn, order_id)
+    if order["status"] == STATUS_CANCELLED:
+        raise InvalidState("Bestellung ist schon storniert")
+    ordered = dict(_lines(order["items"]))
+    for sku, quantity in lines:
+        if quantity > ordered.get(sku, 0):
+            raise ValidationFailed(
+                f"{sku}: nur {ordered.get(sku, 0)} bestellt"
+            )
+    partial = bool(lines) and lines != _lines(order["items"])
+    if order["tracking_number"] is not None:
+        labels.void_label(conn, order_id)
+    if order["status"] == STATUS_SHIPPED:
+        inventory.restock(conn, lines or _lines(order["items"]))
+    else:
+        inventory.release(conn, lines or _lines(order["items"]))
+    new_status = (
+        STATUS_PART_CANCELLED if partial else STATUS_CANCELLED
+    )
+    now = clock().isoformat(timespec="seconds")
+    conn.execute(
+        "UPDATE orders SET status = ?, cancelled_at = ?, "
+        "cancel_reason = ? WHERE id = ?",
+        (new_status, now, reason, order_id),
+    )
+    for sku, quantity in lines:
+        conn.execute(
+            "UPDATE order_items SET quantity = quantity - ? "
+            "WHERE order_id = ? AND sku = ?",
+            (quantity, order_id, sku),
+        )
+    if refund and order["status"] != STATUS_NEW:
+        conn.execute(
+            "INSERT INTO refunds "
+            "(order_id, amount, created_at) VALUES (?, ?, ?)",
+            (order_id, _refund_amount(order, lines), now),
+        )
+    conn.execute(
+        "INSERT INTO status_log (order_id, old_status, "
+        "new_status, changed_at) VALUES (?, ?, ?, ?)",
+        (order_id, order["status"], new_status, now),
+    )
+    conn.commit()
+    return get_order(conn, order_id)
+
+
