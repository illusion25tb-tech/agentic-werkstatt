+def cancel_order(
+    conn: sqlite3.Connection,
+    order_id: int,
+    email: str,
+    clock: Callable[[], datetime] = datetime.now,
+) -> dict:
+    """Storno durch den Kunden (NL-105)."""
+    order = get_order(conn, order_id)
+    if email.strip().lower() != order["customer_mail"].lower():
+        raise Forbidden("E-Mail passt nicht zur Bestellung")
+    if order["tracking_number"] is not None:
+        raise InvalidState(
+            "Label existiert, Storno nur über den Kundenservice"
+        )
+    old_status = order["status"]
+    if old_status not in (STATUS_NEW, STATUS_PAID):
+        raise InvalidState(
+            f"Storno im Status {old_status} nicht möglich"
+        )
+    inventory.release(conn, _lines(order["items"]))
+    conn.execute(
+        "UPDATE orders SET status = ? WHERE id = ?",
+        (STATUS_CANCELLED, order_id),
+    )
+    conn.execute(
+        "INSERT INTO status_log (order_id, old_status, "
+        "new_status, changed_at) VALUES (?, ?, ?, ?)",
+        (
+            order_id,
+            old_status,
+            STATUS_CANCELLED,
+            clock().isoformat(timespec="seconds"),
+        ),
+    )
+    conn.commit()
+    return get_order(conn, order_id)
+
+
